# Supabase (public anon key is safe in the browser; RLS protects the data)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Claude, used only by the server function api/chat.js. Never prefix with VITE_.
ANTHROPIC_API_KEY=your_anthropic_api_key

# CREA DDF® live search outside Ontario (api/ddf-search.js)
DDF_CLIENT_ID=your_crea_ddf_client_id
DDF_CLIENT_SECRET=your_crea_ddf_client_secret
