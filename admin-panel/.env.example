# Supabase (public anon key is safe in the browser; RLS protects the data)
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Claude, used only by the server function api/ai.js. Never prefix with VITE_.
ANTHROPIC_API_KEY=your_anthropic_api_key

# CREA DDF® (MLS®) sync, used only by api/ddf-sync.js (set in the admin Vercel project)
DDF_CLIENT_ID=your_crea_ddf_client_id
DDF_CLIENT_SECRET=your_crea_ddf_client_secret
DDF_AGENT_KEYS=jigars_agent_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
CRON_SECRET=any_long_random_string
