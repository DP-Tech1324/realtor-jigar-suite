{
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "functions": {
    "api/ddf-sync.js": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/ddf-sync?run=morning", "schedule": "0 8 * * *" },
    { "path": "/api/ddf-sync?run=night-1", "schedule": "0 20 * * *" },
    { "path": "/api/ddf-sync?run=night-2", "schedule": "0 21 * * *" },
    { "path": "/api/ddf-sync?run=night-3", "schedule": "0 22 * * *" },
    { "path": "/api/ddf-sync?run=night-4", "schedule": "0 23 * * *" }
  ]
}
